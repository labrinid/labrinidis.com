---
layout: page
---
<div class="post">
  <article>
    {{ content }}

    {% assign c = site.data.contact %}
    {% assign s = site.data.socials %}
    {% assign obfuscated_email = s.email | replace: '@', ' [at] ' | replace: '.', ' [dot] ' %}

    <div class="row mt-3">
      <div class="col-md-6">

        <h2>Contact</h2>
        <p>
          <strong>Email:</strong> {{ obfuscated_email }}<br>
          <strong>Phone:</strong> {{ c.phone }}<br>
          <strong>Office:</strong> {{ c.building }}, Room {{ c.room }}<br>
          <strong>Office Hours:</strong> {{ c.office_hours }}
        </p>

        <h2>Mailing Address</h2>
        <p>
          {{ c.name }}<br>
          {{ c.department }}<br>
          {{ c.university }}<br>
          {{ c.building }}, Room {{ c.room }}<br>
          {{ c.street }}<br>
          {{ c.city }}, {{ c.state }} {{ c.zip_usps }} <small class="text-muted">(US Postal Service)</small><br>
          {{ c.city }}, {{ c.state }} {{ c.zip_courier }} <small class="text-muted">(courier deliveries)</small><br>
          USA
        </p>

        <h2>Online Profiles</h2>
        <ul>

          {% if s.linkedin_username %}
            <li><strong>LinkedIn:</strong> <a href="https://linkedin.com/in/{{ s.linkedin_username }}" target="_blank">linkedin.com/in/{{ s.linkedin_username }}</a></li>
          {% endif %}
		
          {% if s.medium_username %}
            <li><strong>Medium:</strong> <a href="https://medium.com/@{{ s.medium_username }}" target="_blank">medium.com/@{{ s.medium_username }}</a></li>
          {% endif %}
		  
          {% if s.scholar_userid %}
            <li><strong>Google Scholar:</strong> <a href="https://scholar.google.com/citations?user={{ s.scholar_userid }}" target="_blank">scholar.google.com</a></li>
          {% endif %}
		  
		  {% if s.scholar_userid %}
		    {% assign scholar_link = c.scholar_url | default: 'https://scholar.google.com/citations?user=' | append: s.scholar_userid %}
		    <li><strong>Google Scholar TEST:</strong> <a href="{{ scholar_link }}" target="_blank">scholar.google.com</a></li>
		  {% endif %}
		  
          {% if s.dblp_url %}
            <li><strong>DBLP:</strong> <a href="{{ s.dblp_url }}" target="_blank">dblp.org</a></li>
          {% endif %}

          {% if s.orcid_id %}
            <li><strong>ORCID:</strong> <a href="https://orcid.org/{{ s.orcid_id }}" target="_blank">{{ s.orcid_id }}</a></li>
          {% endif %}
		  
          {% if s.semanticscholar_id %}
            <li><strong>Semantic Scholar:</strong> <a href="https://www.semanticscholar.org/author/{{ s.semanticscholar_id }}" target="_blank">semanticscholar.org</a></li>
          {% endif %}
		  		  		  
          {% if s.github_username %}
            <li><strong>GitHub:</strong> <a href="https://github.com/{{ s.github_username }}" target="_blank">github.com/{{ s.github_username }}</a></li>
          {% endif %}
		  

        </ul>

      </div>

      <div class="col-md-6">
        <h2>Location</h2>
        <iframe
          src="{{ c.maps_embed }}"
          width="100%"
          height="300"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </div>

  </article>
</div>
