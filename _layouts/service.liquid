---
layout: page
---
<div class="post">
  <article>
    {{ content }}

    {% assign community = site.data.service_community %}
    {% assign university = site.data.service_university %}
    {% assign show_all = page.show_all %}

    <!-- External / Community Service -->
    <h2>External Service</h2>

    {% for category in community %}
      {% assign cat_name = category[0] | replace: '_', ' ' | capitalize %}
      {% assign cat_items = category[1] %}

      {% if show_all %}
        {% assign items = cat_items %}
      {% else %}
        {% assign items = cat_items | where: "selected", true %}
      {% endif %}

      {% if items.size > 0 %}
        <h3>{{ cat_name }}</h3>
        <table class="table table-sm">
          <tbody>
            {% assign sorted_items = items | sort: "year" | reverse %}
            {% for item in sorted_items %}
            <tr>
              <td style="width:12%; white-space:nowrap;">
                {% if item.year %}{{ item.year }}{% elsif item.years %}{{ item.years }}{% endif %}
              </td>
              <td style="width:25%">{{ item.role }}</td>
              <td>
                {% if item.url %}
                  <a href="{{ item.url }}" target="_blank">{{ item.venue }}</a>
                {% else %}
                  {{ item.venue }}
                {% endif %}
                {% if item.full_name %}
                  <br><small class="text-muted">{{ item.full_name }}</small>
                {% endif %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      {% endif %}
    {% endfor %}

    <!-- University Service -->
    <h2>University Service</h2>

    {% for category in university %}
      {% assign cat_name = category[0] | replace: '_', ' ' | capitalize %}
      {% assign cat_items = category[1] %}

      {% if show_all %}
        {% assign items = cat_items %}
      {% else %}
        {% assign items = cat_items | where: "selected", true %}
      {% endif %}

      {% if items.size > 0 %}
        <h3>{{ cat_name }}</h3>
        <table class="table table-sm">
          <tbody>
            {% for item in items %}
            <tr>
              <td style="width:12%; white-space:nowrap;">{{ item.years }}</td>
              <td>{{ item.role }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      {% endif %}
    {% endfor %}

    <!-- Link to other view -->
    <hr>
    {% if show_all %}
      <p><a href="/service/">← Back to selected service activities</a></p>
    {% else %}
      <p><a href="/service/full/">View complete service record →</a></p>
    {% endif %}

  </article>
</div>
