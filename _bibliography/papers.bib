@inproceedings{cidr2015-big-data-same-humans,
  author       = {Labrinidis, Alexandros},
  title        = {The Big Data - Same Humans Problem},
  booktitle    = {7th Biennial Conference on Innovative Data Systems Research,
                  {CIDR} 2015, Asilomar, CA, USA, January 4-7, 2015},
  publisher    = {www.cidrdb.org},
  year         = {2015},
  url          = {http://cidrdb.org/cidr2015/Papers/13\_Abstract33LA.pdf},
  keywords     = {big data; human scalability; data management; summarization;
                  ranking; recommendations; visualization; personalization;
                  human-in-the-loop},
  abstract     = {Big data is transforming all aspects of the human experience.
                  While advances in computing technology lead to exponential
                  increases in data generated and processed, the ability of
                  humans to process data has not changed significantly. We refer
                  to this disparity as the Big Data - Same Humans Problem, and
                  argue that scalability from a human's point of view — through
                  summarization, ranking, recommendations, outlier detection,
                  personalization, classification, visualization, and
                  crowd-sourcing — is a critical requirement for successful
                  big data systems and applications.},
  pdf          = {papers/2015/cidr2015-big-data-same-humans.pdf},
  website      = {/papers/2015/cidr2015-big-data-same-humans/},
  selected     = {true}
}

