@article{vldbj2016-avoiding-class-warfare,
  author       = {Pham, Thao N. and
                  Chrysanthis, Panos K. and
                  Labrinidis, Alexandros},
  title        = {Avoiding Class Warfare: Managing Continuous Queries with
                  Differentiated Classes of Service},
  journal      = {The {VLDB} Journal},
  volume       = {25},
  number       = {2},
  pages        = {197--221},
  year         = {2016},
  doi          = {10.1007/s00778-015-0411-4},
  url          = {https://doi.org/10.1007/s00778-015-0411-4},
  keywords     = {data stream management; continuous queries; load shedding;
                  scheduling; quality of service; multi-tenant; DILoS; ALoMa},
  abstract     = {Data stream management systems (DSMSs) offer the most
                  effective solution for processing data streams by efficiently
                  executing continuous queries (CQs) over the incoming data.
                  CQs inherently have different levels of criticality and hence
                  different levels of expected quality of service (QoS) and
                  quality of data (QoD). We propose DILoS, a novel unified
                  framework that exploits the synergy between priority-based
                  scheduling and load shedding to support differentiated QoS
                  and QoD for multiple classes of CQs. We also propose ALoMa,
                  a general adaptive load manager that automatically tunes the
                  headroom factor, honors the delay target, and is applicable
                  to complex query networks with shared operators.},
  pdf          = {papers/2016/vldbj2016-avoiding-class-warfare.pdf},
  website      = {/papers/2016/vldbj2016-avoiding-class-warfare/},
  selected     = {true}
}

